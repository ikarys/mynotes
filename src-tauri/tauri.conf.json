{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mynotes",
  "version": "0.2.0",
  "identifier": "ovh.iks-homelab.mynotes",
  "build": {
    "devUrl": "http://127.0.0.1:5791",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "mynotes",
        "width": 1000,
        "height": 700,
        "visible": false,
        "decorations": false,
        "minWidth": 420,
        "minHeight": 300
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://asset.localhost asset:",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/images/*"
        ]
      },
      "devCsp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://asset.localhost asset: ws://127.0.0.1:5791"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Ikarys",
    "copyright": "Copyright (c) 2026 Ikarys",
    "shortDescription": "A fast notepad with rich text and mind maps",
    "homepage": "https://github.com/ikarys/mynotes",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "windows/sidebar.bmp",
        "headerImage": "windows/header.bmp",
        "uninstallerHeaderImage": "windows/header.bmp",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  }
}
